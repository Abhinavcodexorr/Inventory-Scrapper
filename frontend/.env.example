# Where the API lives. In production nginx serves the UI and proxies /api on
# the same origin, so this is just the site address (e.g. http://159.203.19.28
# or https://inventory.example.com). Locally it is the uvicorn port.
VITE_API_BASE_URL=http://localhost:8000

# There is deliberately NO API key here any more.
#
# Operators sign in with email and password and the browser holds an httpOnly
# session cookie. The previous VITE_API_KEY was compiled into the JavaScript
# bundle at build time, so anyone who could open the page could read the
# server's API key out of it — the cookie cannot be read by script at all.
#
# X-API-Key still exists on the server for machines (health checks, scripts,
# integrations). It should not be given to the browser.
