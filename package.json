{
  "name": "scrapping-cars",
  "private": true,
  "scripts": {
    "api": "node scripts/run-api.mjs",
    "ui": "npm run dev --prefix frontend",
    "frontend": "npm run ui",
    "worker": "node scripts/run-worker.mjs",
    "redis": "node scripts/run-redis.mjs",
    "redis:stop": "node scripts/run-redis.mjs --stop",
    "dev": "concurrently -k -n api,ui -c cyan,magenta \"npm run api\" \"npm run ui\"",
    "dev:all": "concurrently -k -n api,ui,worker -c cyan,magenta,yellow \"npm run api\" \"npm run ui\" \"npm run worker\"",
    "build": "npm run build --prefix frontend",
    "test": "pytest -q",
    "test:live": "pytest -q --live"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
