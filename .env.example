# Copy to .env and fill in. Loaded by dealer_scraper/config.py
DATABASE_URL=postgresql+psycopg://scraper:scraper@localhost:5433/dealer_inventory

# Shared secret every API request must send as the X-API-Key header. Generate
# with e.g. `openssl rand -hex 32`. If left blank, the API refuses ALL
# requests with 503 rather than serving them unauthenticated (see
# API_AUTH_REQUIRED below to opt out in local dev only).
API_KEY=
# Set to false to disable auth entirely — local dev only, never in a
# deployment reachable from outside your machine.
API_AUTH_REQUIRED=true
# JSON array of origins the frontend is served from (CORS allowlist). MUST list
# the address users actually load the admin UI from — on a server that is the
# domain or IP, not localhost. Leaving the local defaults in place makes the UI
# load and then fail every API call in the browser, with the error only visible
# in the developer console. Read once at startup: restart the API after changing.
CORS_ALLOW_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Optional rotating proxy for the scrapers (http://user:pass@host:port). Leave blank for none.
# Use the exact gateway host, port and scheme from your provider's dashboard.
# Credentials containing @ : / # ? % must be percent-encoded here (p@ss -> p%40ss),
# OR leave them out of the URL and set SCRAPER_PROXY_USERNAME / _PASSWORD below
# (no encoding needed; these override any credentials in the URL).
# Test the proxy alone, without touching any dealer site:
#   python scripts/proxy_check.py --auth-only
SCRAPER_PROXY=
SCRAPER_PROXY_USERNAME=
SCRAPER_PROXY_PASSWORD=

# Politeness: seconds between requests to the same dealer, and parallel requests
# per dealer. The variable is PER_DEALER_FETCH_CONCURRENCY — an earlier version
# of this file named it PER_DEALER_CONCURRENCY, which the app ignores silently
# (unknown keys are dropped), so setting that name leaves the default of 4 in
# place. Lower this rather than raise it: parallel requests are what makes a
# dealer's WAF start returning 403, and on a metered proxy they multiply cost
# by the same factor.
DEFAULT_DELAY_SECONDS=1.0
PER_DEALER_FETCH_CONCURRENCY=2

# Removal safety gate: only mark cars removed if we scraped at least this fraction
# of the dealer's reported total (guards against half-failed scrapes corrupting inventory).
RECONCILE_MIN_FRACTION=0.9

# Default HTTP timeout (seconds)
HTTP_TIMEOUT=30

# A car removed for more than this many days (and still absent) is auto-marked 'sold'.
# Leave empty to disable auto-sold (mark sold only from confirmed dealer data).
SOLD_AFTER_DAYS=7

# Who runs a manual sync: local | celery | auto
#   local  = clicking Sync scrapes in-process, right away, with NO worker to run.
#            Simplest for local/UI work. The scrape dies if the API restarts,
#            so avoid it for very long runs behind uvicorn --reload.
#   celery = always queue it; returns 503 if no worker is listening, rather than
#            accepting a sync that would never run.
#   auto   = Celery when a worker is actually consuming, otherwise in-process.
SYNC_BACKEND=auto

# Celery broker/backend (only needed for SYNC_BACKEND=celery/auto and queued daily runs).
# Start worker: npm run worker   (or: celery -A worker.celery_app worker -l info)
REDIS_URL=redis://localhost:6379/0
CELERY_WORKER_CONCURRENCY=3

# -- Discovery engine (dealer_scraper/discovery/) --
# Overall wall-clock budget for one discovery run, in seconds.
DISCOVERY_BUDGET_SECONDS=300
# Seconds discovery waits for a per-host lock before yielding to an
# in-progress scrape (which can hold it for up to SCRAPE_HOST_LOCK_TIMEOUT).
DISCOVERY_HOST_LOCK_TIMEOUT=60
# Cap on active httpx pagination/politeness probe requests per run.
DISCOVERY_PROBE_BUDGET=20
# Optional Claude fallback tier for field mapping — off until explicitly enabled.
DISCOVERY_LLM_ENABLED=false
ANTHROPIC_API_KEY=
DISCOVERY_LLM_MAX_CALLS=3
# JSON object of scalar overrides applied onto HeuristicsConfig — e.g.
# {"link_shape_min_count": 4}. Cannot override regex/tuple fields or scoring
# weights; those require a code change.
DISCOVERY_HEURISTICS_OVERRIDES={}
